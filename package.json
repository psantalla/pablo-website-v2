{
	"name": "pablo-website",
	"version": "2.0.0",
	"description": "Files and Eleventy (11ty) magic to run my personal website.",
	"type": "module",
	"scripts": {
		"posters": "node scripts/video-posters.js",
		"prestart": "npm run posters",
		"prebuild": "npm run posters",
		"build": "eleventy",
		"build-nocolor": "cross-env NODE_DISABLE_COLORS=1 eleventy",
		"build-ghpages": "eleventy --pathprefix=/pablo-website-v2/",
		"start": "eleventy --serve --quiet",
		"start-ghpages": "eleventy --pathprefix=/pablo-website-v2/ --serve --quiet",
		"debug": "cross-env DEBUG=Eleventy* eleventy",
		"debugstart": "cross-env DEBUG=Eleventy* eleventy --serve --quiet",
		"benchmark": "cross-env DEBUG=Eleventy:Benchmark* eleventy"
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/psantalla/pablo-website-v2.git"
	},
	"author": {
		"name": "Pablo Santalla",
		"email": "pablo@pablosantalla.com",
		"url": "https://pablosantalla.com/"
	},
	"license": "MIT",
	"engines": {
		"node": ">=18"
	},
	"funding": {
		"type": "opencollective",
		"url": "https://opencollective.com/11ty"
	},
	"bugs": {
		"url": "https://github.com/psantalla/pablo-website-v2/issues"
	},
	"homepage": "https://github.com/psantalla/pablo-website-v2#readme",
	"devDependencies": {
		"@11ty/eleventy": "^3.1.2",
		"@11ty/eleventy-img": "^6.0.4",
		"@11ty/eleventy-navigation": "^1.0.4",
		"@11ty/eleventy-plugin-rss": "^2.0.4",
		"@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
		"cross-env": "^7.0.3",
		"luxon": "^3.6.1",
		"prismjs": "^1.30.0",
		"zod": "^3.25.67",
		"zod-validation-error": "^3.5.2"
	},
	"dependencies": {
		"@zachleat/heading-anchors": "^1.0.5"
	}
}
