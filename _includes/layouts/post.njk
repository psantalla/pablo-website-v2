---
layout: layouts/base.njk
---
<style>{% include "css/code.css" %}</style>

<h1>{{ title }}</h1>

<ul class="entry-metadata">
	<li class="entry-date">
		<time datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate }}</time>
	</li>
	{% if updated %}
	<li class="entry-date">
		Updated: <time datetime="{{ updated | htmlDateString }}">{{ updated | readableDate }}</time>
	</li>
	{% endif %}
</ul>

{{ content | safe }}

{% if changelog %}
<details class="entry-changelog">
	<summary class="entry-changelog-summary">Changelog</summary>
	<ul class="entry-changelog-list">
	{% for change in changelog %}
		<li>{{ change }}</li>
	{% endfor %}
	</ul>
</details>
{% endif %}

{# Tags displayed after content #}
<ul class="entry-metadata">
	{%- for tag in tags | filterTagList %}
	{%- set tagUrl %}/tags/{{ tag | slugify }}/{% endset %}
	<li><a href="{{ tagUrl }}" class="entry-taxonomy">{{ tag }}</a></li>
	{%- endfor %}
</ul>
