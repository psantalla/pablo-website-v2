---
layout: layouts/base.njk
---
<style>{% include "css/code.css" %}</style>

<h1>{{ title }}</h1>

<ul class="entry-metadata">
	<li class="entry-date">
		<time datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate("yyyy") }}</time>
	</li>
	{%- if madeAt and madeAt != "Freelance" %}
	<li class="entry-date">
		Made at
		{%- if agencies[madeAt] %}
		<a href="{{ agencies[madeAt] }}" target="_blank" rel="noopener noreferrer">{{ madeAt }}</a>
		{%- else %}
		{{ madeAt }}
		{%- endif %}
	</li>
	{%- endif %}
	{%- if projectLink %}
	<li class="entry-date">
		{%- set isRepo = "github.com/" in projectLink or "gitlab.com/" in projectLink or "bitbucket.org/" in projectLink %}
		<a href="{{ projectLink }}" target="_blank" rel="noopener noreferrer">{{ "View repository" if isRepo else "View live site" }}</a>
	</li>
	{%- endif %}
</ul>

{%- if projectTopics %}
<ul class="entry-metadata">
	{%- for topic in projectTopics %}
	{%- set topicUrl %}/project-topics/{{ topic | slugify }}/{% endset %}
	<li><a href="{{ topicUrl }}" class="entry-taxonomy">{{ topic }}</a></li>
	{%- endfor %}
</ul>
{%- endif %}

{{ content | safe }}
